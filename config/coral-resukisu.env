CONFIG_ENV=config.env

# ============================================================ Kernel source ==

KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_google_msm-4.14
KERNEL_SOURCE_BRANCH=lineage-23.2
KERNEL_CONFIG=floral_defconfig
KERNEL_IMAGE_NAME=Image.lz4
ARCH=arm64

KERNEL_NAME=coral
ADD_LOCALVERSION_TO_FILENAME=false

EXTRA_CMDS:LD=ld.lld KCFLAGS=-Wno-error=strict-prototypes
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==

CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=
USE_LLVM=false

# ===================================================================== GCC ==

ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===

KSU_VARIANT=resukisu
# README: leave blank to let the action pick a sensible ref for the kernel
# version -- ReSukiSU is explicitly aimed at legacy/non-GKI kernels, so its
# own ref-selection logic should already land somewhere 4.14-appropriate.
KSU_REF=
# Manual hooks are required for stability on MSM-4.14. patch.sh also has a
# ReSukiSU-specific path: it clones ReSukiSU_Patches and looks for a
# scope-minimized/kernel-<kver>.patch keyed to this exact kernel version,
# falling back to the generic legacy hook script only if that's missing.
KSU_HOOK_MODE=manual

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==

# ReSukiSU does not bundle SUSFS itself (only sukisu-ultra's 'builtin' ref
# does), so this still goes through the standard kernel-4.14 SUSFS route and
# the KernelSU-side 10_enable_susfs_for_ksu.patch. The README's "old kernel +
# modern fork + SUSFS" rough edge applies here same as kernelsu-next/official
# -- watch the build log for that patch failing to apply.
ENABLE_SUSFS=true
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=kernel-4.14

# ========================================================== Extra patches ===

# README: pre-5.9 kernels need this true, or module unmounting silently
# does nothing. No variant-specific exception is documented.
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================================================================ Kconfig ===

ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=true
EXTRA_DEFCONFIG=CONFIG_LOCALVERSION_AUTO=n CONFIG_KSU_SUSFS=y CONFIG_KSU_SUSFS_SUS_PATH=y CONFIG_KSU_SUSFS_SUS_MOUNT=y CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT=y

# ============================================================= AnyKernel3 ===

USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===

NEED_DTBO=false

# Set to false to output AnyKernel3 flashable zip (easier to flash in recovery)
# If set to true, ensure SOURCE_BOOT_IMAGE is a valid, working download link
BUILD_BOOT_IMG=true
SOURCE_BOOT_IMAGE=https://mirrorbits.lineageos.org/full/coral/20260904/boot.img

# ================================================================= Runner ===

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
